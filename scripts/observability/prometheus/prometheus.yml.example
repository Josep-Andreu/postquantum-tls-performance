global:
  scrape_interval: 1s
  evaluation_interval: 1s
  scrape_timeout: 900ms

scrape_configs:
  - job_name: "pqc-tls-ebpf"
    static_configs:
      - targets: ["web.lab.example.com:9101"]
        labels:
          environment: "pqc-lab"
          service: "apache"
          observer: "ebpf"

  - job_name: "pqc-web-node"
    static_configs:
      - targets: ["web.lab.example.com:9100"]
        labels:
          environment: "pqc-lab"
          role: "web-server"
          experiment: "tls-pqc"
